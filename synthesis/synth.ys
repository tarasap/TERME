read_verilog src\TERME.v 		src\ALU.v 			src\ALU_Lane.v 			src\ALU_Decoder.v 
read_verilog src\Branch_Unit.v 		src\Memory_WriteBack.v
read_verilog src\TERME_Controller.v 	src\CSRs.v 			src\CSR_Controller.v 		
read_verilog src\Decode_Execute.v 	src\Decompressor.v		src\Decoder2.v 			src\Decoder1.v 
read_verilog src\Hazard_Unit.v 		src\Instruction_Load_Unit.v 	src\Sign_Extension.v 
read_verilog src\TERME_Engine.v		src\Load_Store_Unit.v 		src\Zmmul_Decoder.v		src\Mul_Unit.v
read_verilog src\Regfile.v 		src\Fetch.v 
read_verilog src\Mux_2.v 		src\Mux_3.v 			src\Mux_4.v
read_verilog src\Reg.v			src\Pipe_Register.v

synth -top TERME

flatten -noscopeinfo

read_liberty -lib stdcells.lib
dfflibmap -liberty stdcells.lib

abc -liberty stdcells.lib -constr abc.constr -script +strash;ifraig;retime;strash;dch;map;buffer;upsize;dnsize;stime;
opt -full
clean

setundef -undriven -zero
write_verilog -noattr TERME.v
stat -liberty stdcells.lib
